# HIC backend production environment.
# Copy to <APP_DIR>/backend/.env, fill every REQUIRED value, then `chmod 600`.
# (Named env.production.template, not .env.production.template: the repo's
#  .gitignore excludes .env.* so the old name could never be committed.)
#
# Never commit the filled-in copy. Never paste real keys into docs.

# ── Required ───────────────────────────────────────────────────────────────
APP_ENV=production                      # enables fail-closed startup checks
MONGO_URL=mongodb://127.0.0.1:27017     # REQUIRED
DB_NAME=hybrid_intelligence             # REQUIRED
JWT_SECRET_KEY=                         # REQUIRED, >= 32 chars. e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
                                        # Startup refuses to run in production without it.
EMERGENT_LLM_KEY=                       # REQUIRED for any engine to run
FRONTEND_URL=https://app.example.com    # used for billing/email redirect links
CORS_ORIGINS=https://app.example.com    # comma-separated explicit origins. '*' allows any origin WITHOUT credentials.

# ── SLA113 operator access ─────────────────────────────────────────────────
SLA113_OPERATOR_KEY=                    # REQUIRED to use SLA113 writes, >= 24 chars. Entered once in the SLA113 console.
SLA113_AUTH_MODE=enforce                # enforce | audit (audit logs would-be denials without blocking)
SLA113_PUBLIC_DEPLOY_LIMIT=5            # anonymous showcase demo deploys per client per window
SLA113_PUBLIC_DEPLOY_WINDOW=3600        # seconds
# SLA113_GEMINI_IMAGE_EXCEPTION=enabled # OFF by default. Enables the Gemini image route, a recorded
#                                       # exception to the no-Google model policy. Founder decision.
# GEMINI_API_KEY=                       # only used if the exception above is enabled
# SPRITE_PROXY_ALLOWED_HOSTS=           # optional comma-separated allowlist for /sla113/sprites/proxy

# ── Billing (Stripe) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                  # REQUIRED if STRIPE_SECRET_KEY is set: webhooks are rejected without it
STRIPE_PRO_PRICE_ID=
# STRIPE_ENTERPRISE_PRICE_ID=

# ── Email (optional) ───────────────────────────────────────────────────────
# RESEND_API_KEY=
# SENDER_EMAIL=

# ── OAuth (optional) ───────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Paths (optional; default to locations inside this backend checkout) ───
# HIC_EXECUTION_LOG_FILE=
# SLA113_DEPLOY_ROOT=
